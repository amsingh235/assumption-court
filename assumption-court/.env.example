GEMINI_API_KEY=
GEMINI_MODEL=            # set from Google AI Studio docs
LLM_PROVIDER=gemini      # gemini | openai_compat | ollama | fake (fake = deterministic offline stand-in, no key needed)
LLM_FALLBACK_PROVIDER=   # optional backup when the main provider is overloaded / out of quota, e.g. openai_compat
OLLAMA_MODEL=
# Any OpenAI-compatible API, e.g. Groq (https://api.groq.com/openai/v1) or OpenRouter (https://openrouter.ai/api/v1)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=     # copy the exact model id from the provider's model list
RETRIEVAL_PROVIDER=live  # live (DuckDuckGo + Wikipedia) | fake (offline placeholder sources)
JUDGE_DECISIVE_GAP=3
MAX_EVIDENCE_PER_SIDE=3
TRIAL_RATE_LIMIT=5       # POST /trial per IP per hour
TRIAL_TIMEOUT_S=300     # real trials make ~20-50 LLM calls; 120 is often too short on free tiers
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:8000
